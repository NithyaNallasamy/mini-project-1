Package Mini Project 1 as a Helm Chart
Instead of managing 5 individual YAML manifests (01-config.yaml, 02-redis.yaml, 03-frontend.yaml, 04-ingress.yaml, 
05-hpa.yaml), Helm combines them into a reusable package governed by a single values.yaml file.

1. Directory Structure
Inside your project directory (~/projects/my-k8s-project/), create the chart layout:

helm create k8s-mini-project-1

This generates a template tree:

k8s-mini-project-1/
├── Chart.yaml          # Metadata (name, version, appVersion)
├── values.yaml         # Default configuration values
└── templates/          # Jinja/Go-templated Kubernetes manifests
    ├── deployment.yaml
    ├── service.yaml
    ├── ingress.yaml
    ├── hpa.yaml
    ├── NOTES.txt
    └── _helpers.tpl

Run this command to create the folders cleanly:

mkdir -p k8s-mini-project-1/templates
cd k8s-mini-project-1

2. Chart Metadata (Chart.yaml)

apiVersion: v2
name: k8s-mini-project-1
description: A multi-tier web application with Redis persistence, Ingress routing, and HPA
type: application
version: 0.1.0
appVersion: "6.5.4"

3. Central Values Configuration (values.yaml)

global:
  namespace: mini-project-1

frontend:
  replicaCount: 2
  image:
    repository: ghcr.io/stefanprodan/podinfo
    tag: 6.5.4
    pullPolicy: IfNotPresent
  service:
    type: ClusterIP
    port: 80
  resources:
    limits:
      cpu: 150m
      memory: 64Mi
    requests:
      cpu: 50m
      memory: 32Mi
  env:
    logLevel: info
    backendUrl: "http://redis-svc:6379"

redis:
  image:
    repository: redis
    tag: 7-alpine
    pullPolicy: IfNotPresent
  password: "SuperSecureK8sPassword123!"
  storage:
    size: 1Gi
    accessMode: ReadWriteOnce
  resources:
    limits:
      cpu: 200m
      memory: 128Mi
    requests:
      cpu: 50m
      memory: 64Mi

ingress:
  enabled: true
  className: nginx
  host: myapp.local

autoscaling:
  enabled: true
  minReplicas: 2
  maxReplicas: 6
  targetCPUUtilizationPercentage: 50

4. Template Manifests (templates/)
templates/_helpers.tpl

{{/* Common labels */}}
{{- define "app.labels" -}}
helm.sh/chart: {{ .Chart.Name }}-{{ .Chart.Version }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end }}

templates/secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: {{ .Release.Name }}-secret
  labels:
    {{- include "app.labels" . | nindent 4 }}
type: Opaque
stringData:
  REDIS_PASSWORD: {{ .Values.redis.password | quote }}

templates/configmap.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ .Release.Name }}-config
  labels:
    {{- include "app.labels" . | nindent 4 }}
data:
  REDIS_HOST: "redis-svc"
  REDIS_PORT: "6379"
  LOG_LEVEL: {{ .Values.frontend.env.logLevel | quote }}
  BACKEND_URL: {{ .Values.frontend.env.backendUrl | quote }}

templates/redis-service.yaml

apiVersion: v1
kind: Service
metadata:
  name: redis-svc
  labels:
    app: redis
    {{- include "app.labels" . | nindent 4 }}
spec:
  clusterIP: None
  ports:
    - port: 6379
      name: redis
  selector:
    app: redis
    app.kubernetes.io/instance: {{ .Release.Name }}

templates/redis-statefulset.yaml

apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: redis
  labels:
    app: redis
    {{- include "app.labels" . | nindent 4 }}
spec:
  serviceName: "redis-svc"
  replicas: 1
  selector:
    matchLabels:
      app: redis
      app.kubernetes.io/instance: {{ .Release.Name }}
  template:
    metadata:
      labels:
        app: redis
        app.kubernetes.io/instance: {{ .Release.Name }}
    spec:
      containers:
        - name: redis
          image: "{{ .Values.redis.image.repository }}:{{ .Values.redis.image.tag }}"
          imagePullPolicy: {{ .Values.redis.image.pullPolicy }}
          command:
            - "redis-server"
            - "--appendonly"
            - "yes"
            - "--requirepass"
            - "$(REDIS_PASSWORD)"
            - "--dir"
            - "/data"
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ .Release.Name }}-secret
                  key: REDIS_PASSWORD
          ports:
            - containerPort: 6379
              name: redis
          volumeMounts:
            - name: redis-storage
              mountPath: /data
          resources:
            {{- toYaml .Values.redis.resources | nindent 12 }}
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - redis-cli -a "$REDIS_PASSWORD" ping | grep PONG
            initialDelaySeconds: 5
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: 6379
            initialDelaySeconds: 5
            periodSeconds: 10
  volumeClaimTemplates:
    - metadata:
        name: redis-storage
      spec:
        accessModes:
          - {{ .Values.redis.storage.accessMode | quote }}
        resources:
          requests:
            storage: {{ .Values.redis.storage.size | quote }}

templates/frontend-service.yaml

apiVersion: v1
kind: Service
metadata:
  name: frontend-svc
  labels:
    app: frontend
    {{- include "app.labels" . | nindent 4 }}
spec:
  type: {{ .Values.frontend.service.type }}
  ports:
    - port: {{ .Values.frontend.service.port }}
      targetPort: 9898
      name: http
  selector:
    app: frontend
    app.kubernetes.io/instance: {{ .Release.Name }}

templates/frontend-deployment.yaml

apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend-deployment
  labels:
    app: frontend
    {{- include "app.labels" . | nindent 4 }}
spec:
  replicas: {{ .Values.frontend.replicaCount }}
  selector:
    matchLabels:
      app: frontend
      app.kubernetes.io/instance: {{ .Release.Name }}
  template:
    metadata:
      labels:
        app: frontend
        app.kubernetes.io/instance: {{ .Release.Name }}
    spec:
      containers:
        - name: web
          image: "{{ .Values.frontend.image.repository }}:{{ .Values.frontend.image.tag }}"
          imagePullPolicy: {{ .Values.frontend.image.pullPolicy }}
          ports:
            - containerPort: 9898
              name: http
          envFrom:
            - configMapRef:
                name: {{ .Release.Name }}-config
          env:
            - name: PODINFO_BACKEND_URL
              value: "http://redis-svc:6379"
          resources:
            {{- toYaml .Values.frontend.resources | nindent 12 }}
          readinessProbe:
            httpGet:
              path: /readyz
              port: 9898
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /healthz
              port: 9898
            initialDelaySeconds: 5
            periodSeconds: 10


templates/NOTES.txt

